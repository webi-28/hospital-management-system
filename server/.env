# ============================================================
# Hospital Management System – Server Environment (DEVELOPMENT)
# Copy this file and rename to .env, then fill in your values.
# ============================================================

PORT=5000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_management
DB_USER=postgres
DB_PASSWORD=Kwatg4526$

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=hms_dev_secret_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ── Client URL (CORS) ─────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Cloudinary (optional) ─────────────────────────────────────
# Leave blank to use local disk storage in /server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HMS <noreply@hospital.com>
